#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx and a 301 redirect for /redirect_me

apt-get update
apt-get install -y nginx

echo "Hello World!" > /var/www/html/index.html

# Add a location block with a 301 redirect right after the server_name line
sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default

nginx -t
service nginx restart
