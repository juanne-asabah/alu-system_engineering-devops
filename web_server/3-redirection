#!/usr/bin/env bash
# Configures an Ubuntu machine with Nginx and a 301 redirect for /redirect_me

apt-get update
apt-get install -y nginx

echo "Hello World!" > /var/www/html/index.html

# Add the 301 redirect rule right after the server_name line
sed -i '/server_name _;/a \        rewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default

service nginx restart
