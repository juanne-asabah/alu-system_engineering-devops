#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx, 301 redirection, and custom 404

# Update and install Nginx
apt-get update -y
apt-get install -y nginx

# Stop Apache2 if it is running and occupying port 80
service apache2 stop 2>/dev/null || true

# Setup index page and custom 404 content
mkdir -p /var/www/html
echo "Hello World!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

# Configure Nginx default site cleanly
cat << 'EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    rewrite ^/redirect_me https://youtube.com permanent;

    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
EOF

# Ensure symlink exists in sites-enabled
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Test configuration and restart Nginx
nginx -t && service nginx restart
