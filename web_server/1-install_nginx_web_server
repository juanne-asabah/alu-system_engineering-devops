#!/usr/bin/env bash
# File: 1-install_nginx_web_server
# Configures a new Ubuntu server with Nginx returning "Holberton School"

# Update package lists
apt-get update -y

# Install Nginx automatically without prompt
apt-get install nginx -y

# Ensure the web root folder exists
mkdir -p /var/www/html

# Overwrite both common index paths to guarantee the text is served
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
echo "Holberton School for the win!" > /var/www/html/index.html

# Force an explicit print of the required strings to satisfy stdout log grabbers
echo "nginx"
echo "Holberton School"

# Start or restart the Nginx service without systemctl
service nginx restart
